{
  "datasets": [
    {
      "name": "3137af74",
      "displayName": "v_hourly_device_health",
      "queryLines": [
        "SELECT * FROM trial.secure.v_hourly_device_health"
      ]
    },
    {
      "name": "cbd28c21",
      "displayName": "Worst availability - last 24h",
      "queryLines": [
        "SELECT\r\n",
        "    device_type,\r\n",
        "    device,\r\n",
        "    location,\r\n",
        "    tenant,\r\n",
        "    value_kind,\r\n",
        "    avg(availability_pct) AS avg_availability_pct,\r\n",
        "    sum(gap_minutes) AS total_gap_minutes\r\n",
        "FROM secure.v_hourly_device_health\r\n",
        "WHERE reading_hour >= date_trunc('hour', current_timestamp() - INTERVAL 21 DAYS)\r\n",
        "    AND upper(value_kind) NOT IN (\"ENCENDIDO\", \"ON/OFF\", \"MODO\", \"switch\")\r\n",
        "    AND (availability_pct <= 90)\r\n",
        "GROUP BY device_type, device, location, tenant, value_kind\r\n",
        "ORDER BY avg_availability_pct ASC\r\n",
        "LIMIT 20;\r\n"
      ]
    },
    {
      "name": "abb56c61",
      "displayName": "Irregular operation - sensors",
      "queryLines": [
        "WITH base AS (\r\n",
        "    SELECT *\r\n",
        "    FROM secure.v_hourly_device_health\r\n",
        "    WHERE reading_hour >= date_trunc('hour', current_timestamp() - INTERVAL 18 DAY)\r\n",
        "),\r\n",
        "calc AS (\r\n",
        "    SELECT\r\n",
        "        base.*,\r\n",
        "        (max_value - min_value) AS range_value,\r\n",
        "        stddev_pop(max_value - min_value) OVER () AS sd_range\r\n",
        "    FROM base\r\n",
        ")\r\n",
        "SELECT\r\n",
        "    reading_hour,\r\n",
        "    device_type,\r\n",
        "    device,\r\n",
        "    sensor_type,\r\n",
        "    avg_value,\r\n",
        "    value_kind,\r\n",
        "    stddev_value,\r\n",
        "    location,\r\n",
        "    availability_pct\r\n",
        "FROM calc\r\n",
        "WHERE ( \r\n",
        "        :device_type IS NULL\r\n",
        "        OR size(:device_type) = 0\r\n",
        "        OR exists(:device_type, x -> upper(x) = upper(device_type))\r\n",
        "    )\r\n",
        "    AND  ( \r\n",
        "        :sensor_type IS NULL\r\n",
        "        OR size(:sensor_type) = 0\r\n",
        "        OR exists(:sensor_type, x -> upper(x) = upper(sensor_type))\r\n",
        "    )\r\n",
        "    AND  ( \r\n",
        "        :location IS NULL\r\n",
        "        OR size(:location) = 0\r\n",
        "        OR exists(:location, x -> upper(x) = upper(location))\r\n",
        "    )\r\n",
        "ORDER BY reading_hour DESC;\r\n"
      ],
      "parameters": [
        {
          "displayName": "sensor_type",
          "keyword": "sensor_type",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "operator": {
              "operator": "AND"
            }
          }
        },
        {
          "displayName": "device_type",
          "keyword": "device_type",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "operator": {
              "operator": "AND"
            }
          }
        },
        {
          "displayName": "location",
          "keyword": "location",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "operator": {
              "operator": "AND"
            }
          }
        }
      ]
    },
    {
      "name": "0723ed85",
      "displayName": "Device trends - reads",
      "queryLines": [
        "SELECT\r\n",
        "    reading_hour,\r\n",
        "    sensor_type,\r\n",
        "    avg(avg_value) AS avg_value,\r\n",
        "    avg(availability_pct) AS availability_pct\r\n",
        "FROM secure.v_hourly_device_health\r\n",
        "WHERE ( \r\n",
        "        :device_type IS NULL\r\n",
        "        OR size(:device_type) = 0\r\n",
        "        OR exists(:device_type, x -> upper(x) = upper(device_type))\r\n",
        "    )\r\n",
        "    AND reading_hour >= date_trunc('hour', current_timestamp() - INTERVAL 48 HOURS)\r\n",
        "GROUP BY reading_hour, sensor_type\r\n",
        "ORDER BY reading_hour;\r\n"
      ],
      "parameters": [
        {
          "displayName": "device_type",
          "keyword": "device_type",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {
            "operator": {
              "operator": "AND"
            }
          }
        }
      ]
    }
  ],
